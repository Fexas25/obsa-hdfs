# Template for scripts/live-test.sh. Copy OUTSIDE the repository, fill in,
# and restrict its permissions (chmod 600). Never commit the filled copy.

# Object bucket (required). For Huawei Cloud use the regional OBS endpoint,
# e.g. obs.cn-north-4.myhuaweicloud.com, with OBS_LIVE_SECURE=true.
OBS_LIVE_ENDPOINT=obs.<region>.myhuaweicloud.com
OBS_LIVE_SECURE=true
OBS_LIVE_BUCKET=<object-bucket-name>
OBS_LIVE_ACCESS_KEY=<access-key>
OBS_LIVE_SECRET_KEY=<secret-key>
# obs = OBS-native signatures (use for Huawei Cloud); v2 = S3-compatible.
OBS_LIVE_SIGNATURE=obs

# Optional: server-side encryption on the object bucket.
# OBS_LIVE_SSE_TYPE=sse-kms            # optional key id in OBS_LIVE_SSE_KEY
# OBS_LIVE_SSE_TYPE=sse-c
# OBS_LIVE_SSE_KEY=<base64 of a random 32-byte key>

# Optional: a parallel file system (PFS) bucket for PFS semantics.
# OBS_LIVE_PFS_BUCKET=<pfs-bucket-name>
# OBS_LIVE_PFS_ACCESS_LABEL=true       # needs AccessLabel permission

# Root-directory contracts delete EVERYTHING in OBS_LIVE_BUCKET; enable only
# for a dedicated, empty test bucket.
# OBS_LIVE_ROOT_TESTS=true
